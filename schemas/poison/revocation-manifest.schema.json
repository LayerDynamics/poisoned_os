{
  "$id": "https://poisoned.invalid/schemas/revocation-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "expiresAt": {
      "format": "date-time",
      "type": "string"
    },
    "issuedAt": {
      "format": "date-time",
      "type": "string"
    },
    "issuerKeyId": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "type": "string"
    },
    "revokedArtifactDigests": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "revokedKeyIds": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "poison.revocations/v1"
    },
    "scope": {
      "enum": [
        "content",
        "firmware",
        "package",
        "provenance",
        "support-bundle"
      ]
    },
    "sequence": {
      "minimum": 0,
      "type": "integer"
    },
    "signature": {
      "contentEncoding": "base64",
      "minLength": 8,
      "type": "string"
    },
    "signatureAlgorithm": {
      "const": "ECDSA-P256-SHA256"
    },
    "version": {
      "const": 1
    }
  },
  "required": [
    "schema",
    "version",
    "sequence",
    "issuedAt",
    "expiresAt",
    "scope",
    "issuerKeyId",
    "revokedKeyIds",
    "revokedArtifactDigests",
    "signatureAlgorithm",
    "signature"
  ],
  "title": "PoisonedOS Revocation Manifest",
  "type": "object"
}
