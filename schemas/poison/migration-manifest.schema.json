{
  "$id": "https://poisoned.invalid/schemas/migration-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoisonedOS legacy migration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "converterVersion", "entries"],
  "properties": {
    "schema": {"const": "poison.migration-manifest/v1"},
    "converterVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["sourcePath", "sourceSha256", "bytes", "logicalPath", "classification", "requiredFreeBytes", "backup"],
      "properties": {
        "sourcePath": {"type": "string", "pattern": "^/(?:int|ext)/[^\\x00-\\x1f]+$", "maxLength": 256},
        "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "logicalPath": {"type": "string", "pattern": "^/(?:apps|scripts|captures|settings|unknown)/[^\\x00-\\x1f]+$", "maxLength": 256},
        "classification": {"enum": ["compatible", "convertible", "unsupported", "unknown"]},
        "requiredFreeBytes": {"type": "integer", "minimum": 0},
        "backup": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes", "verified"], "properties": {
          "path": {"type": "string", "pattern": "^[^/][^\\x00-\\x1f]*$", "maxLength": 256},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "verified": {"const": true}
        }}
      }
    }}
  }
}
