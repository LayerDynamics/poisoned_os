{
  "$id": "https://poisoned.invalid/schemas/support-bundle.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoisonedOS local support bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "consent", "components", "counters", "events", "files"],
  "properties": {
    "schema": {"const": "poison.support-bundle/v1"},
    "consent": {"type": "object", "required": ["previewed", "acceptedAtMs"], "additionalProperties": false, "properties": {"previewed": {"const": true}, "acceptedAtMs": {"type": "integer", "minimum": 1}}},
    "components": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "maxLength": 64}, "version": {"type": "string", "maxLength": 64}}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["sessionEstablished", "transportErrors", "droppedFrames", "retriedFrames", "commandFailures", "appCrashes", "policyDenials"], "properties": {"sessionEstablished": {"type": "integer", "minimum": 0}, "transportErrors": {"type": "integer", "minimum": 0}, "droppedFrames": {"type": "integer", "minimum": 0}, "retriedFrames": {"type": "integer", "minimum": 0}, "commandFailures": {"type": "integer", "minimum": 0}, "appCrashes": {"type": "integer", "minimum": 0}, "policyDenials": {"type": "integer", "minimum": 0}}},
    "events": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["eventId", "category", "summary", "timestampMs", "correlationDigest"], "properties": {"eventId": {"type": "integer", "minimum": 1}, "category": {"type": "string", "maxLength": 24}, "summary": {"type": "string", "maxLength": 96}, "timestampMs": {"type": "integer", "minimum": 0}, "correlationDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "files": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^/ext/"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}}
  }
}
