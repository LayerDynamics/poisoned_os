{
  "$id": "https://poisoned.invalid/schemas/package-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PoisonedOS signed content package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["packageFormat", "contentType", "id", "version", "firmwareApi", "payloads", "entrypoint", "capabilities", "contentSha256", "signingKeyId", "releaseSequence"],
  "properties": {
    "packageFormat": {"const": 1},
    "contentType": {"enum": ["application", "firmware", "lesson", "tool-data", "theme", "font", "icon", "font-icon", "menu", "resource", "ui-pack"]},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32},
    "firmwareApi": {"type": "string", "pattern": "^(?:[0-9]+\\.[0-9]+\\.[0-9]+|>=[0-9]+\\.[0-9]+\\.[0-9]+ <[0-9]+\\.[0-9]+\\.[0-9]+)$", "maxLength": 64},
    "payloads": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"], "properties": {"path": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 256}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0, "maximum": 4294967295}}}},
    "entrypoint": {"type": "string", "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$", "maxLength": 256},
    "capabilities": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^(?:status|device\\.status\\.read|device\\.read.*|control|ui\\..*|runtime\\..*|notification\\..*|crypto\\..*|compute\\..*|launch|device\\.app\\.run|app\\..*|files|storage\\..*|evidence|evidence\\..*|radio|radio\\..*|nfc\\..*|lf-rfid\\..*|ibutton\\..*|infrared\\..*|sub-ghz\\..*|gpio\\..*|serial\\..*|ble\\..*|native|native\\..*|badusb\\..*|usb-hid\\..*|destructive)$", "minLength": 1, "maxLength": 64}},
    "contentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signingKeyId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
    "releaseSequence": {"type": "integer", "minimum": 1, "maximum": 4294967295},
    "signature": {"type": "string", "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 108}
  }
}
