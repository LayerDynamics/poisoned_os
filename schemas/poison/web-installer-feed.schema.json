{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poison.web-installer-feed/v1",
  "type": "object",
  "required": ["schema", "releases"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "poison.web-installer-feed/v1" },
    "releases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["manifest", "packageComponentId", "packageUrl"],
        "additionalProperties": false,
        "properties": {
          "manifest": { "$ref": "#/$defs/signedReleaseManifest" },
          "packageComponentId": { "$ref": "#/$defs/identifier" },
          "packageUrl": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "component": {
      "type": "object",
      "required": ["id", "path", "sha256", "bytes"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "path": { "type": "string", "pattern": "^(?:[a-zA-Z0-9._-]+/)*[a-zA-Z0-9._-]+$" },
        "sha256": { "$ref": "#/$defs/digest" },
        "bytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "keyId": { "$ref": "#/$defs/identifier" },
        "value": { "type": "string", "minLength": 8, "maxLength": 256, "contentEncoding": "base64" }
      }
    },
    "signedReleaseManifest": {
      "type": "object",
      "required": ["schema", "version", "channel", "target", "rollbackVersion", "components", "revocations", "signature"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "poison.release-manifest/v1" },
        "version": { "$ref": "#/$defs/version" },
        "channel": { "enum": ["internal", "developer", "beta", "stable"] },
        "target": { "enum": ["7", "f7"] },
        "rollbackVersion": { "$ref": "#/$defs/version" },
        "minimumVersion": { "$ref": "#/$defs/version" },
        "maximumVersion": { "$ref": "#/$defs/version" },
        "components": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/component" } },
        "revocations": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/digest" } },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
