{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poison.release-manifest/v1",
  "type": "object",
  "required": ["schema", "version", "channel", "target", "rollbackVersion", "components", "revocations"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "poison.release-manifest/v1" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "channel": { "enum": ["internal", "developer", "beta", "stable"] },
    "target": { "type": "string", "pattern": "^[a-z0-9._-]{1,32}$" },
    "rollbackVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "minimumVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "maximumVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "components": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "type": "object", "required": ["id", "path", "sha256", "bytes"], "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" }, "path": { "type": "string", "pattern": "^(?:[a-zA-Z0-9._-]+/)*[a-zA-Z0-9._-]+$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "bytes": { "type": "integer", "minimum": 1 } } } },
    "revocations": { "type": "array", "maxItems": 64, "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "signature": {
      "type": "object",
      "required": ["algorithm", "keyId", "value"],
      "additionalProperties": false,
      "properties": {
        "algorithm": { "const": "ECDSA-P256-SHA256" },
        "keyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "value": { "type": "string", "contentEncoding": "base64", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 108 }
      }
    }
  }
}
