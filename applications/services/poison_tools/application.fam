App(
    appid="poison_tools",
    name="Poison Tool Catalog",
    apptype=FlipperAppType.STARTUP,
    entry_point="poison_tools_on_system_start",
    requires=[
        "esp32_marauder_driver",
        "poison_app",
        "poison_evidence",
        "poison_profiles",
        "poison_vfs_start",
        "storage",
    ],
    order=129,
    sources=[
        "*.c",
        "../../../lib/ble_profile/extra_profiles/hid_profile.c",
        "../../../lib/ble_profile/extra_services/hid_service.c",
    ],
    sdk_headers=[
        "poison_tools.h",
        "poison_marauder_adapter.h",
        "poison_esp_adapter.h",
        "poison_gpio_adapter.h",
        "poison_ibutton_adapter.h",
        "poison_infrared_adapter.h",
        "poison_subghz_adapter.h",
        "poison_usb_hid_adapter.h",
        "poison_ble_adapter.h",
        "poison_nfc_adapter.h",
        "poison_lfrfid_adapter.h",
        "poison_serial_adapter.h",
        "poison_storage_adapter.h",
        "poison_tool_adapters.h",
    ],
    fap_libs=["ibutton", "infrared", "subghz", "ble_profile", "nfc", "lfrfid"],
)
