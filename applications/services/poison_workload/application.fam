App(
    appid="poison_workload",
    name="Poison JavaScript Workload",
    apptype=FlipperAppType.STARTUP,
    entry_point="poison_workload_on_system_start",
    order=130,
    requires=["js_app", "loader", "poison_evidence", "poison_packages"],
