{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poison.lesson/v1",
  "type": "object",
  "required": ["schema", "id", "version", "title", "signature", "steps"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "poison.lesson/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" },
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 96 },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "steps": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "object", "required": ["id", "kind", "title"], "additionalProperties": false, "properties": { "id": { "type": "string", "pattern": "^[a-z0-9._-]{1,64}$" }, "kind": { "enum": ["explanation", "device-action", "browser-action", "observation", "evidence-checkpoint", "knowledge-check", "starter-code", "reset"] }, "title": { "type": "string", "minLength": 1, "maxLength": 96 }, "requiredEvidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } } }
  }
}
