{
  "name": "@poisonedos/dashboard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test -- --run && pnpm build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "build": "vite build",
    "dev": "tsx server/main.ts --dev",
    "dev:ui": "vite",
    "start": "tsx server/main.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.14.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.0.2",
    "tsx": "4.23.12",
    "typescript": "5.9.2",
    "vite": "7.1.3",
    "vitest": "3.2.4"
  }
}
