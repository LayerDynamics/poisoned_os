{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "poison.release.requirement-evidence/v1",
  "type": "object",
  "required": ["schema", "requirements"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "poison.release.requirement-evidence/v1" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "milestone", "command", "evidence", "version", "result", "reviewer", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^(FR|NFR|REL)-[0-9A-Z._-]+$" },
          "milestone": { "type": "string", "pattern": "^M[0-6]$" },
          "command": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "result": { "enum": ["PASS", "FAIL", "BLOCKED"] },
          "reviewer": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "minLength": 1 },
          "physicalIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
